rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBanned != true;
    }

    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if false;

      match /notifications/{notificationId} {
        allow get, list: if isOwner(uid) || isAdmin();
        allow create: if false;
        allow update: if isOwner(uid)
          && resource.data.readAt == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
          && request.resource.data.readAt is timestamp;
        allow delete: if isOwner(uid);
      }

      match /receipts/{receiptId} {
        allow get, list: if isOwner(uid) || isAdmin();
        allow create, update, delete: if false;
      }

      match /transfers/{transferId} {
        allow get, list: if isOwner(uid) || isAdmin();
        allow create, update, delete: if false;
      }

      match /profitActivity/{activityId} {
        allow get, list: if isOwner(uid) || isAdmin();
        allow create, update, delete: if false;
      }
    }

    match /receipts/{receiptId} {
      allow get: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow list: if (isAdmin() && resource.data.status == 'pending')
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /withdrawals/{withdrawalId} {
      allow get: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow list: if (isAdmin() && resource.data.status == 'pending')
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /profitCycles/{cycleId} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /usernames/{username} {
      allow get: if signedIn();
      allow list, create, update, delete: if false;
    }

    match /usernameClaims/{username} {
      allow read, write: if false;
    }

    match /accountRoles/{uid} {
      allow read, write: if false;
    }

    match /balances/{uid} {
      allow read, write: if false;
    }

    match /transfers/{transferId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
