# Browser Firebase config. These values are public client identifiers, not server secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Server-only credentials. Configure these in Render's private environment settings.
FIREBASE_SERVICE_ACCOUNT_JSON=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Receiving addresses. Leave a network blank until its address has been verified.
BTC_BITCOIN=
USDT_ETHEREUM=
USDT_BSC=
USDT_TRON=
USDT_SOLANA=
USDT_TON=
USDC_ETHEREUM=
USDC_SOLANA=
USDC_ARBITRUM=
USDC_SUI=
ETH_ETHEREUM=
ETH_ARBITRUM=
BNB_BSC=
SOL_SOLANA=
GRAM_TON=
TRX_TRON=
SUI_SUI=

# Set for local Vite development if its origin differs from the API origin.
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
